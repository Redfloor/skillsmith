{
  "$defs": {
    "ToolContract": {
      "additionalProperties": false,
      "description": "A single MCP tool's externally-observable contract.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolContract",
      "type": "object"
    }
  },
  "$id": "https://skillsmith.dev/schemas/contract_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Committed *.mcpc.json artifact: the snapshot of a server's tool contracts.",
  "properties": {
    "behavior_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Behavior Fingerprint"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "server_id": {
      "title": "Server Id",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolContract"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "server_id"
  ],
  "title": "ContractSnapshot",
  "type": "object"
}